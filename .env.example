# Postgres connection string. Leave unset to use the embedded PGlite database
# stored in .data/pglite (local development only: one process at a time).
# DATABASE_URL=postgres://user:pass@host:5432/vitalsigns

# Public URL of this app, used in alert links and the install snippet.
# APP_URL=https://vitalsigns.example.com

# Shared secret for the hourly alert check (GET /api/cron/alerts).
# Vercel Cron sends it automatically as a Bearer token.
CRON_SECRET=change-me

# Optional: email alerts via Resend (https://resend.com).
# RESEND_API_KEY=
# ALERT_FROM_EMAIL="VitalSigns <alerts@yourdomain.com>"
